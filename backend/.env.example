PORT=4000
DATABASE_URL=postgres://groupsave:groupsave@localhost:5432/groupsave
JWT_SECRET=change-me-long-random-string
# Used to encrypt phone numbers at rest and to derive lookup hashes
ENC_KEY=change-me-another-long-random-string
# Shared secret the USSD gateway must send: POST /ussd?secret=...
GATEWAY_SECRET=change-me-gateway-secret
# Africa's Talking (leave blank to log SMS to the console instead)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
CORS_ORIGIN=http://localhost:5173

# Online meetings use Jitsi Meet. Default is the free public server; set your own to keep video private.
JITSI_BASE_URL=https://meet.jit.si
