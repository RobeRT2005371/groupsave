# Copy to .env.production and replace all generated values before deployment.
# Use URL-safe hexadecimal values for secrets to keep DATABASE_URL parsing reliable.
DB_PASSWORD=replace-with-long-random-hex
JWT_SECRET=replace-with-a-different-long-random-hex
ENC_KEY=replace-with-another-long-random-hex
GATEWAY_SECRET=replace-with-a-different-long-random-hex

# Public URL served by the TLS-terminating reverse proxy.
CORS_ORIGIN=https://groupsave.example.org
WEB_PORT=8080

# Africa's Talking; leave blank to log SMS to the API container.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# For production, prefer an organization-managed Jitsi server.
JITSI_BASE_URL=https://meet.jit.si
